# URL pública da LP, com https e sem barra no final.
# Usada no build para canonical, Open Graph, sitemap.xml, robots.txt e dados estruturados.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Banco: Postgres do Supabase na VPS (serviço `supabase` do projeto portal_atletas no Easypanel).
# Os leads do formulário da Black Friday vão para o schema `paginas` (criado pelo Alembic em db/).
# A senha é a POSTGRES_PASSWORD das variáveis do serviço Supabase.
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_SCHEMA=paginas
DATABASE_SSL=false
