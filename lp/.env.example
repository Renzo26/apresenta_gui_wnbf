# URL pública da LP, com https e sem barra no final.
# Usada no build para canonical, Open Graph, sitemap.xml, robots.txt e dados estruturados.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Banco: Postgres do Supabase na VPS (serviço `supabase` do projeto portal_atletas no Easypanel).
# Os leads do formulário da Black Friday vão para o schema `paginas` (criado pelo Alembic em db/).
# A senha é a POSTGRES_PASSWORD das variáveis do serviço Supabase.
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_SCHEMA=paginas
DATABASE_SSL=false

# Meta Pixel e API de Conversões.
# O ID do Pixel é público. O token é SECRETO: só no Easypanel, nunca no Git.
# META_TEST_EVENT_CODE: código da aba "Testar eventos" do Gerenciador de Eventos; apague depois do teste.
NEXT_PUBLIC_META_PIXEL_ID=1104861572184949
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# Resposta automática do WhatsApp (n8n): chave secreta que o n8n manda no header x-n8n-token
# ao chamar /api/whatsapp/resposta. Gere com: openssl rand -hex 32
N8N_WHATSAPP_TOKEN=
